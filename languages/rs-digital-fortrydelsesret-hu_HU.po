#: includes/class-rs-fr-settings.php:649
msgid "Vigtigt: Formularen selv vises ikke af denne tekst. Tilføj shortcoden [digital_fortrydelse] på siden, som tokenet peger på, for at vise fortrydelsesformularen der."
msgstr "Fontos: ez a szöveg magát az űrlapot nem jeleníti meg. Az elállási űrlap megjelenítéséhez szúrja be a [digital_fortrydelse] shortcode-ot arra az oldalra, amelyre a token mutat."

#: includes/class-rs-fr-settings.php:743
msgid "Afsnittet om digital fortrydelse blev opdateret på handelsbetingelsessiden."
msgstr "A digitális elállásról szóló szövegrész frissítve lett az általános szerződési feltételek oldalán."

#: includes/class-rs-fr-settings.php:748
msgid "Afsnittet kunne ikke indsættes, fordi der ikke er valgt en gyldig handelsbetingelsesside."
msgstr "A szövegrészt nem sikerült beilleszteni, mert nincs kiválasztva érvényes általános szerződési feltételek oldal."

#: includes/class-rs-fr-settings.php:752
msgid "Afsnittet kunne ikke opdateres på handelsbetingelsessiden."
msgstr "A szövegrészt nem sikerült frissíteni az általános szerződési feltételek oldalán."

