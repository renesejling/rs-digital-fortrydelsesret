#, php-format
msgid "Tokenet peger i øjeblikket på: %s"
msgstr "The token currently points to: %s"

#: includes/class-rs-fr-settings.php:649
msgid "Vigtigt: Formularen selv vises ikke af denne tekst. Tilføj shortcoden [digital_fortrydelse] på siden, som tokenet peger på, for at vise fortrydelsesformularen der."
msgstr "Important: The form itself is not displayed by this text. Add the shortcode [digital_fortrydelse] to the page the token points to in order to display the withdrawal form there."

#: includes/class-rs-fr-settings.php:743
